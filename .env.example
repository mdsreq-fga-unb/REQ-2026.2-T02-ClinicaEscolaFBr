DATABASE_URL=postgresql://clinica:clinica@localhost:5432/clinica
API_PORT=3333
WEB_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
# Só na implantação: remetente e nome de apresentação do relay SMTP do Google
# Workspace (smtp-relay.gmail.com); com uma conta própria, usuário e senha de app
# SMTP_FROM="Clínica Escola FBr <conta@fbr.edu.br>"
# SMTP_EHLO=fbr.edu.br
# SMTP_USER=
# SMTP_PASS=
# Chave da criptografia dos dados de saúde (RNF51). Obrigatória: gere a sua com o comando do Passo 7 do README
CHAVE_DADOS=
# Inscrições públicas novas aceitas por origem a cada 10 minutos (padrão: 20)
# LIMITE_INSCRICOES_POR_ORIGEM=20
# Inscrição pública aberta (padrão: true). Na produção, false até o termo de consentimento (RF57)
# INSCRICAO_ABERTA=true
# Proxies à frente da API na implantação, para o limite valer por visitante (padrão: 0)
# SALTOS_DE_PROXY=1
